# ============================================================
# .env.example — copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── OpenRouter ───────────────────────────────────────────────
# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default free model (used by test scripts)
# Full list: https://openrouter.ai/models?max_price=0
DEFAULT_MODEL=nvidia/nemotron-nano-9b-v2:free

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=openrouter_gateway
MYSQL_USER=orgateway
MYSQL_PASSWORD=change-me-password

# ── Spring Boot ──────────────────────────────────────────────
# JWT secret — must be at least 256 bits (32+ chars), random string
JWT_SECRET=change-me-to-a-random-256-bit-secret-string
JWT_EXPIRATION_MS=86400000

# AES-GCM master key for encrypting stored per-user OpenRouter API keys.
# Must be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=change-me-to-64-hex-chars-from-openssl-rand-hex-32
